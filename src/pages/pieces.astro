</svg>

<div class="progress-strip">
  <div class="progress-inner">
    <span class="progress-label"><span class="num">3</span> / 4 — Pièces</span>
    <div class="progress-seg" role="progressbar" aria-valuenow="3" aria-valuemin="0" aria-valuemax="4" aria-label="Étape 3 sur 4 : Pièces">
      <span class="seg is-done"></span>
      <span class="seg is-done"></span>
      <span class="seg is-current"></span>
      <span class="seg"></span>
    </div>
    <span class="progress-steps-text">Suivant&nbsp;: Récapitulatif</span>
  </div>
</div>

<main class="tunnel" id="main">
  <!-- Anchor -->
  <aside class="lede">
    <span class="t-overline lede-eyebrow">{etape.data.eyebrow}</span>
    <h1>{etape.data.titre}</h1>
    <p>{etape.data.description}</p>
    <div class="lede-points">
      {etape.data.points.map(pt => (
        <div class="lede-point">
          <svg class="ico-lg"><use href={`#${pt.icon}`}/></svg>
          <span><strong>{pt.titre}</strong>{pt.detail}</span>
        </div>
      ))}
    </div>
  </aside>

  <!-- Documents column -->
  <div>
    <div class="profil-bar">
      <span class="profil-bar-ic"><svg class="ico-lg"><use href="#i-cap"/></svg></span>
      <span class="profil-bar-txt">Pièces adaptées à votre profil&nbsp;: <strong id="pb-label">…</strong></span>
      <span class="em-badge em-badge--info" id="pb-dossier">Dossier —</span>
    </div>

    <div class="aco-banner" id="aco-banner" hidden>
      <svg class="ico-lg"><use href="#i-info"/></svg>
      <span>
        <span class="aco-banner-title">Candidature sous réserve d'obtention du Bac</span>
        <span class="aco-banner-text">Vous candidatez avec vos relevés de Terminale. En cas d'admission, elle sera conditionnelle (ACO)&nbsp;: vous fournirez votre diplôme via le complément de dossier, et la condition sera levée après vérification par l'établissement.</span>
      </span>
    </div>

    <div class="summary">
      <div class="summary-top">
        <span class="summary-count"><span class="n" id="sum-done">0</span> sur <span id="sum-total">0</span> pièces obligatoires envoyées</span>
        <span class="summary-note">PDF ou JPG · taille max par pièce</span>
      </div>
      <div class="summary-bar"><div class="fill" id="sum-fill" style="width:0%;"></div></div>
    </div>

    <div class="doc-list" id="doc-list"></div>

    <!-- Lot 3c-3b + FIX-RETOUR-DOSSIER : geste terminal in-place. Visible en SOU (signalement,
         le dossier reste SOU) ET en INC (re-soumission INC→SOU) ; copie/bouton posés par
         renderResubmit selon le statut. Le bouton est GARDÉ (désactivé tant qu'une pièce est
         rejetée/manquante) mais le back garantit (409). -->
    <div class="resubmit-box" id="resubmit-box" hidden>
      <span>
        <span class="resubmit-title">Vous avez re-déposé vos pièces&nbsp;?</span>
        <span class="resubmit-text">Signalez la fin de votre re-dépôt&nbsp;: votre dossier sera re-contrôlé par le service des admissions — sans frais supplémentaires (aucun nouveau paiement).</span>
      </span>
      <div>
        <button type="button" class="em-btn em-btn--primary" id="resubmit-btn">J'ai re-déposé toutes mes pièces</button>
      </div>
      <span class="resubmit-gate" id="resubmit-gate"></span>
      <div class="resubmit-msg" id="resubmit-msg" role="status" aria-live="polite" hidden></div>
    </div>
  </div>
</main>

<div class="action-bar">
  <div class="action-bar-inner">
    <div class="ab-left">
      <a class="em-btn em-btn--ghost" href="/identite" id="back-pieces"><svg class="ico"><use href="#i-caretleft"/></svg>Retour</a>
      <span class="ab-gate" id="ab-gate"><svg class="ico-sm"><use href="#i-info"/></svg><span id="ab-gate-text">2 pièces obligatoires restantes</span></span>
    </div>
    <div class="ab-right">
      <button type="button" class="em-btn em-btn--primary em-btn--lg" id="ab-next" disabled aria-disabled="true">Continuer vers le récapitulatif<svg class="ico"><use href="#i-caretright"/></svg></button>
    </div>
  </div>
</div>


<script is:inline src="/scripts/admission-tunnel.js?v=7"></script>
<script is:inline src="/scripts/admission-profil.js"></script>
<script is:inline>
/* LOT F (F3) — pièces RÉELLES : liste du dossier (get_dossier) + upload binaire direct
   (upload_piece_file, A0.4). Rendu en DOM sûr (textContent) — aucun nom de fichier
   client ni donnée serveur injectés en HTML. */
(function () {
  'use strict';
  var AT = window.AdmissionTunnel;
  var AP = window.AdmissionProfil;
  document.getElementById('back-pieces').href = AT.buildUrl('/identite');
  /* Token de dossier expiré en cours de route → reprise par OTP. */
  AT.onTokenExpired = function () { AT.navigateTo('/reprise'); };

  var listEl = document.getElementById('doc-list');
  var gateText = document.getElementById('ab-gate-text');
  var nextBtn = document.getElementById('ab-next');
  var pieces = [];   // état SERVEUR : [{code,label,statut,statut_reel,reject_reason,reject_comment,requise}]
  var live = {};     // état LOCAL transitoire : code -> {state,pct,message,fileName}
  var bars = {};     // code -> élément .fill (progression sans re-render)
  var dossierStatut = '';     // Lot 3c-3b : statut du dossier (conditionne re-soumission + CTA tunnel)
  var dossier = null;         // FIX-RETOUR-DOSSIER : dossier complet pour resolveStep (paiement inclus)
  var resubmitDone = false;   // Lot 3c-3b : garde double-clic après un signalement réussi

  /* Descriptions UX locales par code de pièce (catalogue front). */
  var subByCode = {};
  Object.keys(AP.PROFILS).forEach(function (k) {
    AP.piecesPour(AP.PROFILS[k]).forEach(function (p) { subByCode[p.id] = p.sub; });
  });

  /* ---- Helpers DOM sûrs ---- */
  function h(tag, cls, text) {
    var e = document.createElement(tag);
    if (cls) { e.className = cls; }
    if (text != null) { e.textContent = text; }
    return e;
  }
  function svgUse(id, cls) {
    var svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('class', cls || 'ico-lg');
    var use = document.createElementNS('http://www.w3.org/2000/svg', 'use');
    use.setAttribute('href', '#' + id);
    svg.appendChild(use);
    return svg;
  }
  function badge(kind, text) {
    var b = h('span', 'em-badge' + (kind ? ' em-badge--' + kind : ' em-badge--neutral'));
    if (kind === 'success') { b.appendChild(svgUse('i-check', 'ico-sm ico-xs')); }
    b.appendChild(document.createTextNode(text));
    return b;
  }
  function fileInput(code) {
    var input = document.createElement('input');
    input.type = 'file';
    input.accept = '.pdf,.jpg,.jpeg,.png';
    input.addEventListener('change', function () {
      if (input.files && input.files[0]) { startUpload(code, input.files[0]); }
    });
    return input;
  }

  /* ---- Upload (validation client puis multipart, le back revalide tout) ---- */
  function startUpload(code, file) {
    var ext = (file.name.indexOf('.') > -1 ? file.name.split('.').pop() : '').toLowerCase();
    if (['pdf', 'jpg', 'jpeg', 'png'].indexOf(ext) === -1) {
      live[code] = { state: 'error', message: 'Format non accepté — envoyez un PDF, JPG ou PNG.' };
      render(); return;
    }
    if (file.size > 5 * 1024 * 1024) {
      live[code] = { state: 'error', message: 'Fichier trop volumineux (maximum 5 Mo).' };
      render(); return;
    }
    live[code] = { state: 'progress', pct: 0, fileName: file.name };
    render();
    AT.api.uploadPieceFile(code, file, function (res) {
      if (res.ok) {
        delete live[code];
        // Lot 3c-3b : refléter AUSSI l'état réel — le tri, le badge et le bouton « j'ai re-déposé »
        // se recalculent au render() (une rejetée re-déposée repasse « En vérification »).
        pieces.forEach(function (p) {
          if (p.code === code) {
            p.statut = 'deposee'; p.statut_reel = 'uploaded';
            p.reject_reason = null; p.reject_comment = null;
          }
        });
      } else if (res.error && res.error.code === 'OTP_RESENT') {
        AT.navigateTo('/reprise');
        return;
      } else {
        // A3 : distinguer coupure RÉSEAU (retry du même fichier) d'un refus FICHIER (corriger/re-choisir).
        var netErr = res.error && (res.error.code === 'NETWORK_ERROR' || res.error.code === 'TIMEOUT');
        live[code] = { state: 'error', retryFile: netErr ? file : null,
          message: netErr
            ? 'Connexion interrompue. Vérifiez votre réseau, puis réessayez.'
            : ((res.error && res.error.message) || 'Fichier non accepté — corrigez-le puis redéposez.') };
      }
      render();
    }, function (pct) {
      var s = live[code];
      if (s && s.state === 'progress') {
        s.pct = pct;
        if (bars[code]) { bars[code].style.width = pct + '%'; }
      }
    });
  }

  /* ---- Rendu d'une pièce ---- */
  /* A4 (D-UPLOAD-REVIEW-17) : bouton « Voir » — re-visualiser une pièce déposée (miroir viewPiece
     staff). Ouvre le fichier inline (nouvel onglet) via l'endpoint gardé token+OTP. */
  function voirBtn(p) {
    var b = h('button', 'em-btn em-btn--secondary em-btn--sm', null);
    b.type = 'button';
    b.appendChild(svgUse('i-eye', 'ico-sm'));
    var lbl = document.createTextNode('Voir');
    b.appendChild(lbl);
    b.addEventListener('click', function () {
      if (b.disabled) { return; }
      var prev = b.parentNode && b.parentNode.querySelector('.uperror-text');
      if (prev) { prev.remove(); }
      var win = window.open('', '_blank');   // ouvert DANS le geste → non bloqué sur mobile (cible 3G)
      b.disabled = true; lbl.textContent = 'Ouverture…';   // état de chargement (3G : le blob met du temps)
      AT.api.viewOwnPiece(p.code, function (res) {
        b.disabled = false; lbl.textContent = 'Voir';
        if (res && !res.ok) {
          var code = res.error && res.error.code;
          if (code === 'OTP_REQUIRED' || code === 'TOKEN_EXPIRED' || code === 'OTP_RESENT') {
            AT.navigateTo('/reprise'); return;   // ré-auth : cohérent avec le reste du tunnel
          }
          var note = h('span', 'uperror-text', (res.error && res.error.message) || 'Aperçu indisponible.');
          note.setAttribute('role', 'alert');
          if (b.parentNode) { b.parentNode.appendChild(note); }
        }
      }, win);
    });
    return b;
  }

  /* Zone de dépôt (partagée attente / rejetée — Lot 3c-3b). */
  function dropZone(p) {
    var drop = h('label', 'em-file-drop');
    drop.appendChild(fileInput(p.code));
    var ic = h('span', 'em-file-drop-icon'); ic.appendChild(svgUse('i-upload', 'ico-lg ico-26')); drop.appendChild(ic);
    var title = h('span', 'em-file-drop-title', 'Prenez une photo ou ');
    title.appendChild(h('span', 'lnk', 'parcourez vos fichiers'));
    drop.appendChild(title);
    drop.appendChild(h('span', 'em-file-drop-hint', subByCode[p.code] || 'PDF, JPG ou PNG — 5 Mo max.'));
    return drop;
  }
  function bodyFor(p, state) {
    var body = h('div', 'doc-body');
    if (p.code === 'identite') {
      // Sélecteur INFORMATIONNEL (voie b PC1) : 1 seul document, 3 types acceptés. Aucune persistance,
      // n'altère pas l'upload — le libellé reste le porteur. Aide visuelle au candidat.
      var idsel = h('div', 'id-choices');
      idsel.appendChild(h('span', 'doc-sub', 'Un seul document, au choix : '));
      ['CNI', 'Passeport', 'CIP'].forEach(function (t) { idsel.appendChild(badge(null, t)); });
      body.appendChild(idsel);
    }
    if (state.state === 'verified') {
      // Lot 3c-3b : VÉRIFIÉE = acquise, figée — PAS de « Remplacer » (le back refuse :
      // PIECE_ALREADY_VERIFIED). Fix UX préexistant : avant, le bouton menait à une erreur.
      var vrow = h('div', 'filerow');
      var vfi = svgUse('i-check', 'ico-lg fi'); vfi.classList.add('fi'); vrow.appendChild(vfi);
      var vb = h('span', 'filerow-body');
      vb.appendChild(h('span', 'filerow-name', 'Pièce vérifiée'));
      vb.appendChild(h('span', 'filerow-meta', 'Vérifiée par le service des admissions — acquise, rien à faire.'));
      vrow.appendChild(vb);
      var vactions = h('span', 'filerow-actions');
      vactions.appendChild(voirBtn(p));   // A4 : re-consulter la pièce vérifiée (figée)
      vrow.appendChild(vactions);
      body.appendChild(vrow);
      return body;
    }
    if (state.state === 'rejected') {
      // Lot 3c-3b : REJETÉE = motif (le candidat sait POURQUOI) + zone de re-dépôt.
      var motif = p.reject_reason || '';
      if (p.reject_comment) { motif += (motif ? ' — ' : '') + p.reject_comment; }
      var rj = h('div', 'uperror');
      rj.setAttribute('role', 'alert');
      rj.appendChild(svgUse('i-warning', 'ico-lg'));
      var rjb = h('span', 'uperror-body');
      rjb.appendChild(h('span', 'uperror-title', 'Pièce refusée' + (motif ? ' : ' + motif : '') + '.'));
      rjb.appendChild(h('span', 'uperror-text', 'Re-déposez une nouvelle version ci-dessous — sans frais supplémentaires.'));
      rj.appendChild(rjb);
      body.appendChild(rj);
      body.appendChild(dropZone(p));
      return body;
    }
    if (state.state === 'deposee') {
      var row = h('div', 'filerow');
      var fi = svgUse('i-file', 'ico-lg fi'); fi.classList.add('fi'); row.appendChild(fi);
      var rb = h('span', 'filerow-body');
      rb.appendChild(h('span', 'filerow-name', 'Pièce enregistrée'));
      // FIX-PIECES-CONTEXTE (GP5) : le libellé dit l'état RÉEL. En brouillon la pièce n'est pas
      // encore transmise au service → ne pas annoncer une vérification qui n'a pas lieu (et rappeler
      // implicitement qu'une soumission reste à faire). Après soumission → « en attente de vérif. ».
      var brouillon = (dossierStatut === '' || dossierStatut === 'BRO');
      rb.appendChild(h('span', 'filerow-meta', brouillon
        ? 'Enregistrée dans votre dossier — sera transmise au service à la soumission.'
        : 'Reçue — en attente de vérification par le service des admissions.'));
      row.appendChild(rb);
      var actions = h('span', 'filerow-actions');
      actions.appendChild(voirBtn(p));   // A4 : revoir la pièce déposée
      var replaceBtn = h('button', 'em-btn em-btn--secondary em-btn--sm', 'Remplacer');
      replaceBtn.type = 'button';
      var input = fileInput(p.code);
      input.hidden = true;
      replaceBtn.addEventListener('click', function () { input.click(); });
      actions.appendChild(replaceBtn);
      actions.appendChild(input);
      row.appendChild(actions);
      body.appendChild(row);
    } else if (state.state === 'progress') {
      var up = h('div', 'uploading');
      up.setAttribute('role', 'status'); up.setAttribute('aria-live', 'polite');
      var bar = h('div', 'up-bar');
      var fill = h('div', 'fill'); fill.style.width = (state.pct || 0) + '%';
      bars[p.code] = fill;
      bar.appendChild(fill); up.appendChild(bar);
      var rowUp = h('div', 'up-row');
      var stat = h('span', 'up-stat');
      stat.appendChild(h('strong', null, 'Envoi en cours'));
      stat.appendChild(document.createTextNode(' · ' + (state.fileName || '')));
      rowUp.appendChild(stat); up.appendChild(rowUp);
      body.appendChild(up);
    } else if (state.state === 'error') {
      var err = h('div', 'uperror');
      err.setAttribute('role', 'alert');
      err.appendChild(svgUse('i-warning', 'ico-lg'));
      var eb = h('span', 'uperror-body');
      eb.appendChild(h('span', 'uperror-title', 'L’envoi a échoué.'));
      eb.appendChild(h('span', 'uperror-text', state.message || ''));
      var ea = h('span', 'uperror-actions');
      if (state.retryFile) {
        // A3 erreur RÉSEAU : renvoyer le MÊME fichier en un tap (pas de re-navigation sur 3G).
        var retry = h('button', 'em-btn em-btn--secondary', null);
        retry.type = 'button';
        retry.appendChild(svgUse('i-retry', 'ico-sm'));
        retry.appendChild(document.createTextNode('Réessayer'));
        retry.addEventListener('click', function () { startUpload(p.code, state.retryFile); });
        ea.appendChild(retry);
      } else {
        // A3 erreur FICHIER (type/taille/signature) : re-CHOISIR un fichier corrigé (verbe fidèle à l'action).
        var choose = h('button', 'em-btn em-btn--secondary', null);
        choose.type = 'button';
        choose.appendChild(svgUse('i-upload', 'ico-sm'));
        choose.appendChild(document.createTextNode('Choisir un autre fichier'));
        var input2 = fileInput(p.code);
        input2.hidden = true;
        choose.addEventListener('click', function () { input2.click(); });
        ea.appendChild(choose); ea.appendChild(input2);
      }
      eb.appendChild(ea);
      err.appendChild(eb);
      body.appendChild(err);
    } else {
      body.appendChild(dropZone(p));
    }
    return body;
  }

  /* Lot 3c-3b : état RÉEL 4-états, avec repli binaire si le back ne sert pas encore statut_reel
     (déploiement mixte back/front — le warn signale un déploiement incohérent sans casser). */
  function etatReel(p) {
    if (p.statut_reel) { return p.statut_reel; }
    try { console.warn('[3c-3b] statut_reel absent — repli binaire (' + p.code + ')'); } catch (e) {}
    return p.statut === 'deposee' ? 'uploaded' : 'missing';
  }
  function stateFor(p) {
    if (live[p.code]) { return live[p.code]; }
    var sr = etatReel(p);
    if (sr === 'verified') { return { state: 'verified' }; }
    if (sr === 'rejected') { return { state: 'rejected' }; }
    return { state: sr === 'uploaded' ? 'deposee' : 'attente' };
  }
  /* Priorisation d'affichage : à-refaire d'abord, acquises en bas (tri stable). */
  function rangFor(p) {
    var sr = etatReel(p);
    if (sr === 'rejected') { return 0; }
    if (sr === 'missing') { return p.requise ? 1 : 2; }
    if (sr === 'uploaded') { return 3; }
    return 4; // verified
  }

  function render() {
    bars = {};
    listEl.textContent = '';
    // Lot 3c-3b : priorisation — Rejetées → À fournir → En vérification → Vérifiées (tri stable).
    var ordered = pieces.slice().sort(function (a, b) { return rangFor(a) - rangFor(b); });
    ordered.forEach(function (p) {
      var state = stateFor(p);
      var item = h('div', 'doc-item' + (state.state === 'error' ? ' is-error' : '') + (state.state === 'rejected' ? ' is-rejected' : ''));
      var top = h('div', 'doc-top');
      var icCls = state.state === 'deposee' ? 'doc-ic doc-ic--done'
        : state.state === 'progress' ? 'doc-ic doc-ic--active'
        : state.state === 'error' ? 'doc-ic doc-ic--error' : 'doc-ic';
      var ic = h('span', icCls); ic.appendChild(svgUse('i-file')); top.appendChild(ic);
      var info = h('span', 'doc-info');
      var title = h('span', 'doc-title', p.label);
      if (p.requise) {
        var req = h('span', 'doc-req', ' *'); req.setAttribute('aria-hidden', 'true');
        title.appendChild(req);
      } else {
        title.appendChild(h('span', 'doc-opt', ' · optionnel'));
      }
      info.appendChild(title);
      info.appendChild(h('span', 'doc-sub', subByCode[p.code] || ''));
      top.appendChild(info);
      var st = h('span', 'doc-status');
      if (state.state === 'verified') { st.appendChild(badge('success', 'Vérifiée')); }
      else if (state.state === 'rejected') { st.appendChild(badge('error', 'Rejetée')); }
      else if (state.state === 'deposee') {
        // FIX-PIECES-CONTEXTE (GP5) : le badge dit l'état RÉEL, cohérent avec le libellé. En brouillon
        // la pièce n'est pas encore en vérification → « Enregistrée » ; après soumission → « En vérification ».
        var brouillonBadge = (dossierStatut === '' || dossierStatut === 'BRO');
        st.appendChild(badge('info', brouillonBadge ? 'Enregistrée' : 'En vérification'));
      }
      else if (state.state === 'progress') { st.appendChild(badge('info', 'Envoi…')); }
      else if (state.state === 'error') { st.appendChild(badge('error', 'Échec')); }
      else { st.appendChild(badge(null, p.requise ? 'À fournir' : 'En attente')); }
      top.appendChild(st);
      item.appendChild(top);
      item.appendChild(bodyFor(p, state));
      listEl.appendChild(item);
    });

    var req = pieces.filter(function (p) { return p.requise; });
    // Lot 3c-3b : une VÉRIFIÉE compte « envoyée » (non-régression du compteur avec le 4-états).
    var done = req.filter(function (p) { var s = stateFor(p).state; return s === 'deposee' || s === 'verified'; }).length;
    var total = req.length;
    var remaining = total - done;
    document.getElementById('sum-done').textContent = done;
    document.getElementById('sum-total').textContent = total;
    document.getElementById('sum-fill').style.width = (total ? Math.round(done / total * 100) : 0) + '%';

    if (remaining > 0) {
      gateText.textContent = remaining + ' pièce' + (remaining > 1 ? 's' : '') + ' obligatoire' + (remaining > 1 ? 's' : '') + ' restante' + (remaining > 1 ? 's' : '');
      nextBtn.setAttribute('disabled', '');
      nextBtn.setAttribute('aria-disabled', 'true');
      nextBtn.onclick = null;
    } else {
      gateText.textContent = 'Toutes les pièces obligatoires sont envoyées';
      nextBtn.removeAttribute('disabled');
      nextBtn.setAttribute('aria-disabled', 'false');
      /* FIX-RETOUR-DOSSIER : cible calculée (BRO → /recapitulatif ; jamais /paiement pour un payé). */
      nextBtn.onclick = function () { AT.navigateTo(AT.resolveStep(dossier)); };
    }
    /* FIX-RETOUR-DOSSIER : le CTA « continuer vers le récapitulatif » n'a de sens qu'en BRO.
       En INC/SOU, le geste terminal est le bloc de re-soumission (renderResubmit), pas le tunnel.
       Masquage par style.display : le display de .em-btn écrase la règle UA [hidden] (prouvé
       en capture recette — l'attribut hidden seul laissait le bouton visible). */
    var tunnelCta = (dossierStatut === '' || dossierStatut === 'BRO');
    nextBtn.hidden = !tunnelCta;
    nextBtn.style.display = tunnelCta ? '' : 'none';

    renderResubmit();
  }

  /* Lot 3c-3b : bloc « j'ai re-déposé » — SOU uniquement. Le front GUIDE (désactivé avec
     compteur tant qu'une pièce est rejetée) ; le back GARANTIT (409 PIECES_REJECTED_PENDING). */
  function renderResubmit() {
    var box = document.getElementById('resubmit-box');
    if (!box) { return; }
    /* FIX-PIECES-CONTEXTE (Option B, GP1/GP2/GP4) : le bloc n'apparaît QUE s'il y a effectivement
       quelque chose à re-déposer — dossier en complément demandé (INC) OU une pièce rejetée. JAMAIS
       en première constitution (brouillon), ni en SOU sans rejet (le message « sans frais » n'a de
       sens que face à une pièce redemandée). Le geste terminal in-place (INC→SOU / signalement) reste.
       Masquage par style.display : .resubmit-box a display:flex qui ÉCRASE [hidden] — même piège que
       le nextBtn corrigé en juillet ; box.hidden seul laissait le bloc visible (leçon vérité visuelle). */
    var aReDeposer = (dossierStatut === 'INC') ||
                     pieces.some(function (p) { return etatReel(p) === 'rejected'; });
    if (!aReDeposer) { box.hidden = true; box.style.display = 'none'; return; }
    box.hidden = false;
    box.style.display = '';
    var btn = document.getElementById('resubmit-btn');
    var gate = document.getElementById('resubmit-gate');
    /* Copie selon le geste : INC = re-soumettre (repart en étude) ; SOU = signaler le re-dépôt. */
    var title = box.querySelector('.resubmit-title');
    var text = box.querySelector('.resubmit-text');
    if (dossierStatut === 'INC') {
      btn.textContent = 'Re-soumettre mon dossier';
      if (title) { title.textContent = 'Vous avez complété votre dossier ?'; }
      if (text) { text.textContent = 'Re-soumettez votre dossier : il repartira en étude — sans frais supplémentaires (aucun nouveau paiement).'; }
    } else {
      btn.textContent = 'J’ai re-déposé toutes mes pièces';
      if (title) { title.textContent = 'Vous avez re-déposé vos pièces ?'; }
      if (text) { text.textContent = 'Signalez la fin de votre re-dépôt : votre dossier sera re-contrôlé par le service des admissions — sans frais supplémentaires (aucun nouveau paiement).'; }
    }
    if (resubmitDone) {
      btn.setAttribute('disabled', ''); btn.setAttribute('aria-disabled', 'true');
      gate.textContent = '';
      return;
    }
    var rejetees = pieces.filter(function (p) { return etatReel(p) === 'rejected'; }).length;
    var manquantes = pieces.filter(function (p) { return p.requise && etatReel(p) === 'missing'; }).length;
    if (rejetees > 0 || manquantes > 0) {
      btn.setAttribute('disabled', ''); btn.setAttribute('aria-disabled', 'true');
      var reste = rejetees + manquantes;
      gate.textContent = 'Déposez d’abord les pièces à corriger ou à fournir (' + reste + ' restante' + (reste > 1 ? 's' : '') + ').';
    } else {
      btn.removeAttribute('disabled'); btn.setAttribute('aria-disabled', 'false');
      gate.textContent = '';
    }
  }
  document.getElementById('resubmit-btn').addEventListener('click', function () {
    var btn = this;
    var msg = document.getElementById('resubmit-msg');
    btn.setAttribute('disabled', '');                       // garde double-clic
    msg.hidden = false; msg.classList.remove('is-error'); msg.textContent = 'Envoi…';
    /* FIX-RETOUR-DOSSIER : INC → resubmit_complement (INC→SOU, repart en étude) puis retour au
       suivi (pattern in-place ACO/fee2, JAMAIS le tunnel de paiement). SOU → candidate_resubmit
       (le dossier reste SOU, signalement sur place). */
    if (dossierStatut === 'INC') {
      AT.api.resubmitComplement(function (res) {
        if (res.ok) {
          AT.navigateTo('/suivi');
        } else if (res.error && res.error.code === 'OTP_RESENT') {
          AT.navigateTo('/reprise');
        } else {
          btn.removeAttribute('disabled');
          msg.classList.add('is-error');
          msg.textContent = (res.error && res.error.message) || 'Re-soumission impossible. Réessayez.';
        }
      });
      return;
    }
    AT.api.candidateResubmit(function (res) {
      if (res.ok) {
        resubmitDone = true;
        msg.textContent = 'Merci — votre dossier sera re-contrôlé par le service des admissions, sans frais supplémentaires.';
        renderResubmit();
      } else if (res.error && res.error.code === 'OTP_RESENT') {
        AT.navigateTo('/reprise');
      } else {
        btn.removeAttribute('disabled');
        msg.classList.add('is-error');
        msg.textContent = (res.error && res.error.message) || 'Signalement impossible. Réessayez.';
      }
    });
  });

  function showBlocked(message) {
    listEl.textContent = '';
    var box = h('div', 'uperror');
    box.setAttribute('role', 'alert');
    box.appendChild(svgUse('i-warning', 'ico-lg'));
    var eb = h('span', 'uperror-body');
    eb.appendChild(h('span', 'uperror-title', message));
    var ea = h('span', 'uperror-actions');
    var link = h('a', 'em-btn em-btn--secondary', 'Reprendre mon dossier');
    link.href = '/reprise';
    ea.appendChild(link);
    eb.appendChild(ea);
    box.appendChild(eb);
    listEl.appendChild(box);
  }

  /* ---- Chargement initial : la liste des pièces vient du DOSSIER (back) ---- */
  if (!AT.getDossierId() || !AT.getDossierToken()) {
    document.getElementById('pb-label').textContent = '—';
    showBlocked('Aucun dossier en cours sur cet appareil.');
    return;
  }
  AT.api.getDossier(function (res) {
    if (!res.ok) {
      if (res.error && res.error.code === 'OTP_RESENT') { AT.navigateTo('/reprise'); return; }
      showBlocked((res.error && res.error.message) || 'Impossible de charger votre dossier.');
      return;
    }
    var d = res.data;
    pieces = d.pieces || [];
    dossierStatut = d.statut || '';   // Lot 3c-3b : conditionne le bloc re-soumission (INC+SOU)
    dossier = d;                      // FIX-RETOUR-DOSSIER : resolveStep lit statut+paiement+pièces
    document.getElementById('pb-dossier').textContent = 'Dossier ' + d.dossier_id;
    var profilId = String(d.profil_bac || '').replace(/^bac_/, '');
    var profil = AP.PROFILS[profilId];
    document.getElementById('pb-label').textContent = profil ? profil.label : (d.profil_bac || '—');
    document.getElementById('aco-banner').hidden = !d.conditionnel;
    render();
  });
})();
</script>

</TunnelLayout>
